# All settings are optional.
# Uncomment to override the defaults shown below.

#
# Server
#
# SITSMCP_HOST=127.0.0.1
# SITSMCP_PORT=8000

#
# Database
#
# SITSMCP_DB_PATH=sitsmcp.db

#
# Embeddings (local, offline via fastembed)
#
# SITSMCP_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# SITSMCP_EMBEDDING_DIM=1024
# SITSMCP_EMBEDDING_BATCH_SIZE=16

#
# Content sources
#
# SITSMCP_SITSBOOK_URL=https://e-sensing.github.io/sitsbook
# SITSMCP_SITS_REFERENCE_URL=https://e-sensing.github.io/sits
# SITSMCP_REFERENCES_PATH=data/references.json

#
# Chunking
#
# SITSMCP_CHUNK_SIZE=1000
# SITSMCP_CHUNK_OVERLAP=200

#
# Retrieval
#
# SITSMCP_TOP_K=5
# SITSMCP_CANDIDATE_K=20
# SITSMCP_RRF_K=60

#
# Reranking
# Key holders (an API key from SITSMCP_API_KEYS) get the key reranker, Cohere by
# default, and fall back to the default reranker when it fails or is off.
# Open use (no key) gets only the default reranker, which must be local
# (fastembed): open use never calls Cohere. An empty model turns a reranker off;
# the key reranker is also off without SITSMCP_RERANKER_API_KEY.
#
# SITSMCP_KEY_RERANKER_MODEL=cohere/rerank-v5.0-fast
# SITSMCP_DEFAULT_RERANKER_MODEL=fastembed/Xenova/ms-marco-MiniLM-L-6-v2
# SITSMCP_RERANKER_API_KEY=
# SITSMCP_RERANKER_CANDIDATES=20
# SITSMCP_RERANKER_TIMEOUT=2.0

#
# Access (open use stays possible; a key gets its own quota)
#
# SITSMCP_API_KEYS=chat:<a long random key>
# SITSMCP_RATE_LIMIT_OPEN=30
# SITSMCP_RATE_LIMIT_KEY=300

#
# Production (Docker Compose)
# Gunicorn workers; each loads its own embedding model (~1.3 GB of RAM).
#
# WEB_CONCURRENCY=2
